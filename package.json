{
  "name": "inteligentny-kalendarz",
  "private": true,
  "version": "1.2.0-private.234",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/production-audit.mjs && node scripts/service-worker-gate.mjs && node scripts/release-safety-gate.mjs && node scripts/travel-release-gate.mjs && node scripts/security-release-gate.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:public",
    "check": "npm run check:public",
    "preview": "vite preview",
    "benchmark:receipts": "tsc -p scripts/tsconfig.receipt-benchmark.json && node scripts/mark-benchmark-commonjs.mjs && node scripts/receipt-benchmark-runner.mjs",
    "benchmark:receipts:geometry": "tsc -p scripts/tsconfig.receipt-benchmark.json && node scripts/mark-benchmark-commonjs.mjs && node scripts/receipt-geometry-benchmark-runner.mjs",
    "benchmark:receipts:gate2": "tsc -p scripts/tsconfig.receipt-benchmark.json && node scripts/mark-benchmark-commonjs.mjs && node scripts/receipt-gate2-runner.mjs",
    "security:release": "node scripts/security-release-gate.mjs",
    "security:public": "node scripts/public-package-gate.mjs .",
    "security:dependencies": "npm audit --omit=dev --audit-level=high",
    "visual:qa": "node scripts/visual-qa-capture.mjs",
    "travel:gate": "node scripts/travel-release-gate.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:parser-freeze:qa": "node scripts/build192-production-audit-freeze-proof.mjs",
    "release:contract:qa": "node scripts/release-contract-current-proof.mjs",
    "test:public": "vitest run --config vitest.public.config.ts",
    "test:private": "vitest run --config vitest.private.config.ts",
    "check:public": "npm run typecheck && npm run test:public && npm run build",
    "release:local": "node scripts/local-release.mjs",
    "study:audit": "vitest run --config vitest.public.config.ts src/tests/study-source-audit.optional.test.ts --reporter=verbose",
    "checkpoint:state": "node scripts/checkpoint-state-gate.mjs",
    "checkpoint:hygiene": "node scripts/checkpoint-hygiene-gate.mjs",
    "checkpoint:manifest": "node scripts/checkpoint-manifest.mjs",
    "checkpoint:gate": "node scripts/checkpoint-gate.mjs",
    "study:mobile-smoke": "node scripts/study-mobile-smoke.mjs",
    "receipt:corpus:qa": "node scripts/receipt-private-corpus-qa.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "fake-indexeddb": "^6.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "@types/node": "22.19.21"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
