{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inteligentny-kalendarz-push",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // RELEASE RC: przed produkcją ustaw rzeczywisty database_id z Cloudflare D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inteligentny-kalendarz-push",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  // RELEASE RC: localhost jest wyłącznie konfiguracją deweloperską; production origin należy ustawić przed deployem.
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5174"
  },
  "ratelimits": [
    {
      "name": "REGISTER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
